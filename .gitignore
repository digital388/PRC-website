# --- Local environment -------------------------------------------------------
venv/
.env
__pycache__/
*.py[cod]
*.sqlite3

# Generated by collectstatic on the server (never commit)
staticfiles/

# --- Build artifacts / backups ----------------------------------------------
dist/
archive/
extras/
*.tar.gz
*.zip

# --- Local-only files that contain server credentials -----------------------
# config/settings.py itself is committed (it reads env vars); these copies are not.
settingsp.py
config/settings.production.py

# --- Content assets stay on the server, not in git --------------------------
# Uploaded images (admin media) and the large static photo library. They are
# already deployed to ~/prcapp/media and ~/prcapp/website/static; committing
# them adds hundreds of MB for no code benefit.
media/
website/static/website/images/

# Loose working files at the project root
/*.jpg
/*.jpeg
/*.png
/*.docx

# --- Misc -------------------------------------------------------------------
test_write.txt
*.log
.DS_Store
Thumbs.db
